            <column caption='_Etiqueta eje (limpia)' datatype='string' name='[Calculation_1727923151290378]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='REPLACE(&#13;&#10;    REPLACE(&#13;&#10;        REPLACE([Calculation_1727923149885449],&#13;&#10;        &quot; |  | &quot;, &quot; | &quot;),&#13;&#10;    &quot;|  |&quot;, &quot;&quot;),&#13;&#10;&quot;| |&quot;, &quot;&quot;)' />
              <aliases>
                <alias key='&quot;administrative_staff&quot;' value='administración' />
