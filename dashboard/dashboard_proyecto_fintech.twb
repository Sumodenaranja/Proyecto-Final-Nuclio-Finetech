                <alias key='&quot;yes | &gt; 0.5&quot;' value='si | &gt; 0.5' />
              </aliases>
            </column>
            <column caption='Age' datatype='integer' name='[age]' role='measure' type='quantitative' />
            <column caption='Age Group' datatype='string' name='[age_group]' role='dimension' type='nominal' />
            <column caption='alias_education' datatype='string' name='[alias_moda (copia)_0195476292128778]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [education] &#13;&#10;    WHEN &quot;basic_4y&quot; THEN &quot;Básica 4 años&quot;&#13;&#10;    WHEN &quot;high_school&quot; THEN &quot;Bachillerato&quot;&#13;&#10;    WHEN &quot;basic_6y&quot; THEN &quot;Básica 6 años&quot;&#13;&#10;    WHEN &quot;basic_9y&quot; THEN &quot;Básica 9 años&quot;&#13;&#10;    WHEN &quot;professional_course&quot; THEN &quot;Formación profesional&quot;&#13;&#10;    WHEN &quot;university_degree&quot; THEN &quot;Título universitario&quot;&#13;&#10;    WHEN &quot;illiterate&quot; THEN &quot;Analfabeto/a&quot;&#13;&#10;    WHEN &quot;unknown&quot; THEN &quot;Desconocido&quot;&#13;&#10;    ELSE [education] &#13;&#10;END' />
            </column>
