      </column>
      <column caption='_título_var_econ' datatype='string' name='[_título_edad_media (copia)_0273819678060556]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 4]&#13;&#10;    WHEN &quot;Confianza consumidor&quot; THEN &quot;Prom. conf. consum.&quot;&#13;&#10;    WHEN &quot;Índice empleo&quot; THEN &quot;Promedio índice empleo&quot;&#13;&#10;    WHEN &quot;Euribor&quot; THEN &quot;Promedio euribor&quot;&#13;&#10;    WHEN &quot;Índice precios&quot; THEN &quot;Promedio índice precios&quot;&#13;&#10;END' />
