      <column caption='alias_tipo_cont' datatype='string' name='[alias_job (copia)_0190254269607937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [contact_type] &#13;&#10;    WHEN &quot;cellular&quot; THEN &quot;Teléfono móvil&quot;&#13;&#10;    WHEN &quot;telephone&quot; THEN &quot;Teléfono fijo&quot;&#13;&#10;    ELSE [contact_type] &#13;&#10;END' />
      </column>
      <column caption='alias_mes' datatype='string' name='[alias_job (copia)_0190254346452997]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [last_contact_month] &#13;&#10;    WHEN &quot;mar&quot; THEN &quot;marzo&quot;&#13;&#10;    WHEN &quot;apr&quot; THEN &quot;abril&quot;&#13;&#10;    WHEN &quot;may&quot; THEN &quot;mayo&quot;&#13;&#10;    WHEN &quot;jun&quot; THEN &quot;junio&quot;&#13;&#10;    WHEN &quot;jul&quot; THEN &quot;julio&quot;&#13;&#10;    WHEN &quot;aug&quot; THEN &quot;agosto&quot;&#13;&#10;    WHEN &quot;sep&quot; THEN &quot;septiembre&quot;&#13;&#10;    WHEN &quot;oct&quot; THEN &quot;octubre&quot;&#13;&#10;    WHEN &quot;nov&quot; THEN &quot;noviembre&quot;&#13;&#10;    WHEN &quot;dec&quot; THEN &quot;diciembre&quot;&#13;&#10;    ELSE [last_contact_month] &#13;&#10;END' />
      </column>
      <column caption='alias_día' datatype='string' name='[alias_mes (copia)_0982177599602689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [last_contact_day] &#13;&#10;    WHEN &quot;mon&quot; THEN &quot;lunes&quot;&#13;&#10;    WHEN &quot;tue&quot; THEN &quot;martes&quot;&#13;&#10;    WHEN &quot;wed&quot; THEN &quot;miércoles&quot;&#13;&#10;    WHEN &quot;thu&quot; THEN &quot;jueves&quot;&#13;&#10;    WHEN &quot;fri&quot; THEN &quot;viernes&quot;&#13;&#10;    ELSE [last_contact_day] &#13;&#10;END' />
      </column>
      <column caption='alias_estado_civil' datatype='string' name='[alias_moda (copia)_0195476282789896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [marital_status] &#13;&#10;    WHEN &quot;married&quot; THEN &quot;Casado/a&quot;&#13;&#10;    WHEN &quot;single&quot; THEN &quot;Soltero/a&quot;&#13;&#10;    WHEN &quot;divorced&quot; THEN &quot;Divorciado/a&quot;&#13;&#10;    WHEN &quot;unknown&quot; THEN &quot;Desconocido&quot;&#13;&#10;    ELSE [marital_status] &#13;&#10;END' />
      </column>
      <column caption='alias_education' datatype='string' name='[alias_moda (copia)_0195476292128778]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [education] &#13;&#10;    WHEN &quot;basic_4y&quot; THEN &quot;Básica 4 años&quot;&#13;&#10;    WHEN &quot;high_school&quot; THEN &quot;Bachillerato&quot;&#13;&#10;    WHEN &quot;basic_6y&quot; THEN &quot;Básica 6 años&quot;&#13;&#10;    WHEN &quot;basic_9y&quot; THEN &quot;Básica 9 años&quot;&#13;&#10;    WHEN &quot;professional_course&quot; THEN &quot;Formación profesional&quot;&#13;&#10;    WHEN &quot;university_degree&quot; THEN &quot;Título universitario&quot;&#13;&#10;    WHEN &quot;illiterate&quot; THEN &quot;Analfabeto/a&quot;&#13;&#10;    WHEN &quot;unknown&quot; THEN &quot;Desconocido&quot;&#13;&#10;    ELSE [education] &#13;&#10;END' />
      </column>
