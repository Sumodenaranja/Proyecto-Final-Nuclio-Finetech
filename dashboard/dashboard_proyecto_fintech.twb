      </column>
      <column caption='_color_fatiga' datatype='string' name='[_color_edad (copia)_0273819698991118]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3] = &quot;N.º contactos previos&quot; THEN &quot;Activo&quot;&#13;&#10;ELSE &quot;Inactivo&quot;&#13;&#10;END' />
      </column>
