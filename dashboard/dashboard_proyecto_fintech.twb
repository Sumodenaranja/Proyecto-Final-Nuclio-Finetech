            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Perfil del cliente' datatype='string' name='[Parámetro 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Impago&quot;'>
              <calculation class='tableau' formula='&quot;Impago&quot;' />
            </column>
            <column caption='Campaña' datatype='string' name='[Parámetro 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;Ninguno&quot;'>
              <calculation class='tableau' formula='&quot;Ninguno&quot;' />
            </column>
            <column caption='Variables económicas' datatype='string' name='[Parámetro 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;Ninguno&quot;'>
              <calculation class='tableau' formula='&quot;Ninguno&quot;' />
            </column>
            <column caption='Modo métrica' datatype='string' name='[Parámetro 5]' param-domain-type='list' role='measure' type='nominal' value='&quot;Valores absolutos&quot;'>
              <calculation class='tableau' formula='&quot;Valores absolutos&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1f0wf3r1au43lm14km52d0aa94gw'>
            <column caption='nombre % depósito' datatype='string' name='[Calculation_0195476246474753]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [subscribed_term_deposit] = &quot;Yes&quot; THEN &quot;Con crédito&quot;&#13;&#10;ELSE &quot;Sin crédito&quot;&#13;&#10;END' />
            </column>
            <column caption='_Absoluto' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1269976921280513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[Sheet1_AE8FF5659E784E7489B17FCC43510265])' />
            </column>
            <column caption='_Relativo' datatype='real' name='[Calculation_1269976921432066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[Sheet1_AE8FF5659E784E7489B17FCC43510265]) / WINDOW_SUM(COUNT([__tableau_internal_object_id__].[Sheet1_AE8FF5659E784E7489B17FCC43510265]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='_Etiqueta dinámica' datatype='string' name='[Calculation_1269976923639813]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 5] = &quot;Valores absolutos&quot; THEN STR([Calculation_1269976921280513]) ELSE STR(ROUND([Calculation_1269976921432066] * 100, 2)) + &quot;%&quot; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='_Perfil' datatype='string' name='[Calculation_1727923115397121]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN &quot;Edad&quot; THEN [age_group]&#13;&#10;WHEN &quot;Estado civil&quot; THEN [marital_status]&#13;&#10;WHEN &quot;Educación&quot; THEN [education]&#13;&#10;WHEN &quot;Empleo&quot; THEN [job]&#13;&#10;WHEN &quot;Hipoteca&quot; THEN [housing_loan]&#13;&#10;WHEN &quot;Crédito personal&quot; THEN [personal_loan]&#13;&#10;WHEN &quot;Impago&quot; THEN [credit_default]&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;divorced&quot;' value='divorciado/a' />
                <alias key='&quot;married&quot;' value='casado/a' />
                <alias key='&quot;single&quot;' value='soltero/a' />
                <alias key='&quot;student&quot;' value='estudiante' />
                <alias key='&quot;unknown&quot;' value='desconocido' />
              </aliases>
            </column>
            <column caption='_Campaña' datatype='string' name='[Calculation_1727923116236802]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 3]&#13;&#10;WHEN &quot;Último contacto (mes)&quot; THEN [last_contact_month]&#13;&#10;WHEN &quot;Último contacto (día)&quot; THEN [last_contact_day]&#13;&#10;WHEN &quot;Tipo contacto&quot; THEN [contact_type]&#13;&#10;WHEN &quot;Duración último contacto (min)&quot; THEN [last_contact_duration_mins_group]&#13;&#10;WHEN &quot;N.º contactos previos&quot; THEN STR([number_of_previous_contacts])&#13;&#10;WHEN &quot;Campaña previa&quot; THEN [outcome_previous_campaign]&#13;&#10;WHEN &quot;N.º contactos&quot; THEN STR([number_contacts])&#13;&#10;WHEN &quot;N.º días último contacto&quot; THEN STR([number_days_last_contact])&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='_Variables económicas' datatype='string' name='[Calculation_1727923117359107]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 4]&#13;&#10;WHEN &quot;Confianza consumidor&quot; THEN [consumer_confidence_index_group]&#13;&#10;WHEN &quot;Índice empleo&quot; THEN [employement_variation_rate_group]&#13;&#10;WHEN &quot;Euribor&quot; THEN [euribor_3m_group]&#13;&#10;WHEN &quot;Índice precios&quot; THEN [consumer_price_index_group]&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='_Métrica_dinámia' datatype='real' name='[Calculation_1727923120570373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 5] = &quot;Valores absolutos&quot; THEN&#13;&#10;    [Calculation_1269976921280513]&#13;&#10;ELSE&#13;&#10;    [Calculation_1269976921432066]&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
