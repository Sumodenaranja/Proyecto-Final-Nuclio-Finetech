      <aliases enabled='yes' />
      <column caption='% suscritos' datatype='real' default-format='p0.00%' name='[Calculation_0195476214628352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([age]) / SUM({FIXED : COUNT([age])})' />
      </column>
      <column caption='nombre % depósito' datatype='string' name='[Calculation_0195476246474753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [subscribed_term_deposit] = &quot;Yes&quot; THEN &quot;Con crédito&quot;&#13;&#10;ELSE &quot;Sin crédito&quot;&#13;&#10;END' />
      </column>
      <column caption='moda_job' datatype='string' name='[Calculation_0195476273238021]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF { FIXED [job] : COUNT([age]) } = &#13;&#10;       { FIXED : MAX({ FIXED [job] : COUNT([age]) }) }&#13;&#10;    THEN [Calculation_0195476279021574] &#13;&#10;    END&#13;&#10;)}' />
        <aliases>
          <alias key='&quot;administrative_staff&quot;' value='Administración' />
        </aliases>
      </column>
      <column caption='alias_job' datatype='string' name='[Calculation_0195476279021574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [job] &#13;&#10;    WHEN &quot;admin.&quot; THEN &quot;Administración&quot;&#13;&#10;    WHEN &quot;blue_collar&quot; THEN &quot;Construcción&quot;&#13;&#10;    WHEN &quot;technician&quot; THEN &quot;Técnico/a&quot;&#13;&#10;    WHEN &quot;services&quot; THEN &quot;Servicios&quot;&#13;&#10;    WHEN &quot;management&quot; THEN &quot;Manager&quot;&#13;&#10;    WHEN &quot;housemaid&quot; THEN &quot;Empleo doméstico&quot;&#13;&#10;    WHEN &quot;retired&quot; THEN &quot;Jubilado/a&quot;&#13;&#10;    WHEN &quot;unemployed&quot; THEN &quot;Desempleado&quot;&#13;&#10;    WHEN &quot;self_employed&quot; THEN &quot;Autónomo/a&quot;&#13;&#10;    WHEN &quot;unknown&quot; THEN &quot;Desconocido&quot;&#13;&#10;    WHEN &quot;entrepreneur&quot; THEN &quot;Emprendedor&quot;&#13;&#10;    WHEN &quot;student&quot; THEN &quot;Estudiante&quot;&#13;&#10;    ELSE [job] &#13;&#10;END' />
      </column>
      <column caption='_kpi_variables_económicas' datatype='real' name='[Calculation_0273819634323456]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 4]&#13;&#10;&#13;&#10;WHEN &quot;Confianza consumidor&quot; THEN AVG([consumer_confidence_index])&#13;&#10;&#13;&#10;WHEN &quot;Índice empleo&quot; THEN AVG([employement_variation_rate])&#13;&#10;&#13;&#10;WHEN &quot;Euribor&quot; THEN AVG([euribor_3m])&#13;&#10;&#13;&#10;WHEN &quot;Índice precios&quot; THEN AVG([consumer_price_index])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='_filtro_kpi_perfil' datatype='boolean' name='[Calculation_0273819634774017]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 2] &lt;&gt; &quot;Ninguno&quot;' />
      </column>
      <column caption='_filtro_kpi_campaña' datatype='boolean' name='[Calculation_0273819635339266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 3] &lt;&gt; &quot;Ninguno&quot;' />
      </column>
      <column caption='_filtro_kpi_variables_econ' datatype='boolean' name='[Calculation_0273819636293635]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parámetro 4] &lt;&gt; &quot;Ninguno&quot;' />
      </column>
      <column caption='_título_edad_media' datatype='string' name='[Calculation_0273819645419524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Edad&quot; THEN &quot;Edad media&quot;&#13;&#10;END' />
      </column>
      <column caption='_color_edad' datatype='string' name='[Calculation_0273819646025733]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Edad&quot; THEN &quot;Activo&quot;&#13;&#10;ELSE &quot;Inactivo&quot;&#13;&#10;END' />
      </column>
      <column caption='% hipoteca' datatype='real' name='[Calculation_0810930328735746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [housing_loan] = &quot;yes&quot; THEN 1 ELSE 0 END) / COUNT([housing_loan])' />
      </column>
      <column caption='% cred. personal' datatype='real' name='[Calculation_0810930329661443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [personal_loan] = &quot;yes&quot; THEN 1 ELSE 0 END) / COUNT([personal_loan])' />
      </column>
      <column caption='% hipoteca y cred. personal' datatype='real' name='[Calculation_0810930329948164]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [housing_loan] = &quot;yes&quot; AND [personal_loan] = &quot;yes&quot; &#13;&#10;    THEN 1 &#13;&#10;    ELSE 0 &#13;&#10;END&#13;&#10;) / COUNT([housing_loan])' />
      </column>
      <column caption='fatiga' datatype='real' name='[Calculation_0982177634103301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [subscribed_term_deposit] = &quot;yes&quot; THEN [number_of_previous_contacts] END)' />
      </column>
      <column caption='_Absoluto' datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1269976921280513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[Sheet1_AE8FF5659E784E7489B17FCC43510265])' />
      </column>
      <column caption='_Relativo' datatype='real' name='[Calculation_1269976921432066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([__tableau_internal_object_id__].[Sheet1_AE8FF5659E784E7489B17FCC43510265]) / WINDOW_SUM(COUNT([__tableau_internal_object_id__].[Sheet1_AE8FF5659E784E7489B17FCC43510265]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_Etiqueta dinámica' datatype='string' name='[Calculation_1269976923639813]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 5] = &quot;Valores absolutos&quot; THEN STR([Calculation_1269976921280513]) ELSE STR(ROUND([Calculation_1269976921432066] * 100, 2)) + &quot;%&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_tootlip_final' datatype='string' name='[Calculation_1269976942690312]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ATTR([Calculation_1727923115397121]) != &quot;&quot; THEN&#13;&#10;    ATTR([Parameters].[Parámetro 2]) + &quot;: &quot; + ATTR([Calculation_1727923115397121]) + &quot; → &quot; +&#13;&#10;    IF MAX([Parameters].[Parámetro 5]) = &quot;Valores absolutos&quot; THEN STR([Calculation_1269976921280513])&#13;&#10;    ELSE STR(ROUND([Calculation_1269976921432066]*100,1)) + &quot;%&quot; END&#13;&#10;&#13;&#10;ELSEIF ATTR([Calculation_1727923116236802]) != &quot;&quot; THEN&#13;&#10;    ATTR([Parameters].[Parámetro 3]) + &quot;: &quot; + ATTR([Calculation_1727923116236802]) + &quot; → &quot; +&#13;&#10;    IF MAX([Parameters].[Parámetro 5]) = &quot;Valores absolutos&quot; THEN STR([Calculation_1269976921280513])&#13;&#10;    ELSE STR(ROUND([Calculation_1269976921432066]*100,1)) + &quot;%&quot; END&#13;&#10;&#13;&#10;ELSEIF ATTR([Calculation_1727923117359107]) != &quot;&quot; THEN&#13;&#10;    ATTR([Parameters].[Parámetro 4]) + &quot;: &quot; + ATTR([Calculation_1727923117359107]) + &quot; → &quot; +&#13;&#10;    IF MAX([Parameters].[Parámetro 5]) = &quot;Valores absolutos&quot; THEN STR([Calculation_1269976921280513])&#13;&#10;    ELSE STR(ROUND([Calculation_1269976921432066]*100,1)) + &quot;%&quot; END&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;Ninguna variable seleccionada&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_kpi_edad_media' datatype='real' name='[Calculation_1269977003151370]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 2] = &quot;Edad&quot; THEN&#13;&#10;    AVG([age])&#13;&#10;END' />
      </column>
      <column caption='_kpi_fatiga' datatype='real' name='[Calculation_1269977004068875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3] = &quot;N.º contactos previos&quot; THEN&#13;&#10;    AVG(&#13;&#10;        IF [subscribed_term_deposit] = &quot;yes&quot; THEN&#13;&#10;            [number_of_previous_contacts]&#13;&#10;        END&#13;&#10;    )&#13;&#10;END' />
      </column>
      <column caption='kpi_prom_contactos_previos' datatype='real' name='[Calculation_1269977004351500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 3] = &quot;N.º contactos previos&quot; THEN&#13;&#10;    AVG([number_of_previous_contacts])&#13;&#10;END' />
      </column>
      <column caption='kpi_confianza_consumidor' datatype='real' name='[Calculation_1269977004584973]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parámetro 4]) = &quot;Confianza consumidor&quot; THEN&#13;&#10;    AVG([consumer_confidence_index])&#13;&#10;END' />
      </column>
      <column caption='kpi_indice_empleo' datatype='real' name='[Calculation_1269977004822542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parámetro 4]) = &quot;Índice empleo&quot; THEN&#13;&#10;    AVG([employement_variation_rate])&#13;&#10;END' />
      </column>
      <column caption='kpi_euribor' datatype='real' name='[Calculation_1269977004998671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parámetro 4]) = &quot;Euribor&quot; THEN&#13;&#10;    AVG([euribor_3m])&#13;&#10;END' />
      </column>
      <column caption='kpi_precios' datatype='real' name='[Calculation_1269977005125648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parámetro 4]) = &quot;Índice precios&quot; THEN&#13;&#10;    AVG([consumer_price_index])&#13;&#10;END' />
      </column>
      <column caption='Crédito dado' datatype='string' name='[Calculation_1384599845666816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &quot;Segmentado&quot; THEN [subscribed_term_deposit] &#13;&#10;ELSE &quot;Total&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;yes&quot;' value='si' />
        </aliases>
      </column>
      <column caption='Falso' datatype='integer' name='[Calculation_1384599936696322]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Verdadero' datatype='integer' name='[Calculation_1384599936753667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='estado_especial_parámetro' datatype='string' name='[Calculation_1384599956017157]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &quot;Segmentado&quot; THEN [subscribed_term_deposit]&#13;&#10;ELSE &quot;Total - &quot; + STR([marital_status])&#13;&#10;END' />
        <aliases>
          <alias key='&quot;yes&quot;' value='si' />
        </aliases>
      </column>
      <column caption='_Perfil' datatype='string' name='[Calculation_1727923115397121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 2]&#13;&#10;WHEN &quot;Edad&quot; THEN [age_group]&#13;&#10;WHEN &quot;Estado civil&quot; THEN [marital_status]&#13;&#10;WHEN &quot;Educación&quot; THEN [education]&#13;&#10;WHEN &quot;Empleo&quot; THEN [job]&#13;&#10;WHEN &quot;Hipoteca&quot; THEN [housing_loan]&#13;&#10;WHEN &quot;Crédito personal&quot; THEN [personal_loan]&#13;&#10;WHEN &quot;Impago&quot; THEN [credit_default]&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;divorced&quot;' value='divorciado/a' />
          <alias key='&quot;married&quot;' value='casado/a' />
          <alias key='&quot;single&quot;' value='soltero/a' />
          <alias key='&quot;student&quot;' value='estudiante' />
          <alias key='&quot;unknown&quot;' value='desconocido' />
        </aliases>
      </column>
      <column caption='_Campaña' datatype='string' name='[Calculation_1727923116236802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 3]&#13;&#10;WHEN &quot;Último contacto (mes)&quot; THEN [last_contact_month]&#13;&#10;WHEN &quot;Último contacto (día)&quot; THEN [last_contact_day]&#13;&#10;WHEN &quot;Tipo contacto&quot; THEN [contact_type]&#13;&#10;WHEN &quot;Duración último contacto (min)&quot; THEN [last_contact_duration_mins_group]&#13;&#10;WHEN &quot;N.º contactos previos&quot; THEN STR([number_of_previous_contacts])&#13;&#10;WHEN &quot;Campaña previa&quot; THEN [outcome_previous_campaign]&#13;&#10;WHEN &quot;N.º contactos&quot; THEN STR([number_contacts])&#13;&#10;WHEN &quot;N.º días último contacto&quot; THEN STR([number_days_last_contact])&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='_Variables económicas' datatype='string' name='[Calculation_1727923117359107]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 4]&#13;&#10;WHEN &quot;Confianza consumidor&quot; THEN [consumer_confidence_index_group]&#13;&#10;WHEN &quot;Índice empleo&quot; THEN [employement_variation_rate_group]&#13;&#10;WHEN &quot;Euribor&quot; THEN [euribor_3m_group]&#13;&#10;WHEN &quot;Índice precios&quot; THEN [consumer_price_index_group]&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='_nulos' datatype='integer' name='[Calculation_1727923118469124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;IFNULL([Parameters].[Parámetro 2],&quot;&quot;) != &quot;&quot; OR &#13;&#10;IFNULL([Parameters].[Parámetro 3],&quot;&quot;) != &quot;&quot; OR&#13;&#10;IFNULL([Parameters].[Parámetro 4],&quot;&quot;) != &quot;&quot;&#13;&#10;THEN 1 ELSE 0 END' />
      </column>
      <column caption='_Métrica_dinámia' datatype='real' name='[Calculation_1727923120570373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 5] = &quot;Valores absolutos&quot; THEN&#13;&#10;    [Calculation_1269976921280513]&#13;&#10;ELSE&#13;&#10;    [Calculation_1269976921432066]&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_Dimensión final' datatype='string' name='[Calculation_1727923122765831]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([Calculation_1727923115397121]) THEN [Calculation_1727923115397121]&#13;&#10;&#13;&#10;ELSEIF NOT ISNULL([Calculation_1727923116236802]) THEN [Calculation_1727923116236802]&#13;&#10;&#13;&#10;ELSEIF NOT ISNULL([Calculation_1727923117359107]) THEN [Calculation_1727923117359107]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='_Etiqueta eje' datatype='string' name='[Calculation_1727923149885449]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM(&#13;&#10;IF [Calculation_1727923115397121] != &quot;&quot; THEN [Calculation_1727923115397121] ELSE &quot;&quot; END&#13;&#10;+&#13;&#10;IF [Calculation_1727923116236802] != &quot;&quot; &#13;&#10;THEN IF [Calculation_1727923115397121] != &quot;&quot; THEN &quot; | &quot; ELSE &quot;&quot; END + [Calculation_1727923116236802]&#13;&#10;ELSE &quot;&quot; END&#13;&#10;+&#13;&#10;IF [Calculation_1727923117359107] != &quot;&quot; &#13;&#10;THEN IF [Calculation_1727923115397121] != &quot;&quot; OR [Calculation_1727923116236802] != &quot;&quot; THEN &quot; | &quot; ELSE &quot;&quot; END + [Calculation_1727923117359107]&#13;&#10;ELSE &quot;&quot; END&#13;&#10;)' />
        <aliases>
          <alias key='&quot;Estado civil: divorced |  |&quot;' value='Estado civil: divorciado/a |  |' />
          <alias key='&quot;Estado civil: married |  |&quot;' value='Estado civil: casado/a |  |' />
          <alias key='&quot;Estado civil: single |  |&quot;' value='Estado civil: soltero/a |  |' />
          <alias key='&quot;Estado civil: unknown |  |&quot;' value='Estado civil: desconocido |  |' />
        </aliases>
      </column>
      <column caption='_Etiqueta eje (limpia)' datatype='string' name='[Calculation_1727923151290378]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(&#13;&#10;    REPLACE(&#13;&#10;        REPLACE([Calculation_1727923149885449],&#13;&#10;        &quot; |  | &quot;, &quot; | &quot;),&#13;&#10;    &quot;|  |&quot;, &quot;&quot;),&#13;&#10;&quot;| |&quot;, &quot;&quot;)' />
        <aliases>
          <alias key='&quot;administrative_staff&quot;' value='administración' />
