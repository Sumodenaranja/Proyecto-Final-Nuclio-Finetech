      <column caption='_título' datatype='string' name='[Calculation_1727923151925259]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Inicializamos un string vacío&#13;&#10;IF [Parameters].[Parámetro 2] != &quot;Ninguno&quot; THEN &quot;Perfil: &quot; + [Parameters].[Parámetro 2] ELSE &quot;&quot; END&#13;&#10;+&#13;&#10;IF [Parameters].[Parámetro 3] != &quot;Ninguno&quot; THEN &#13;&#10;    // Agrega separador solo si ya hay algo previo&#13;&#10;    IF [Parameters].[Parámetro 2] != &quot;Ninguno&quot; THEN &quot; | &quot; ELSE &quot;&quot; END&#13;&#10;    + &quot;Campaña: &quot; + [Parameters].[Parámetro 3] &#13;&#10;ELSE &quot;&quot; END&#13;&#10;+&#13;&#10;IF [Parameters].[Parámetro 4] != &quot;Ninguno&quot; THEN&#13;&#10;    // Agrega separador solo si hay algo antes&#13;&#10;    IF [Parameters].[Parámetro 2] != &quot;Ninguno&quot; OR [Parameters].[Parámetro 3] != &quot;Ninguno&quot; THEN &quot; | &quot; ELSE &quot;&quot; END&#13;&#10;    + &quot;Variables económicas: &quot; + [Parameters].[Parámetro 4]&#13;&#10;ELSE &quot;&quot; END' />
      </column>
      <column caption='_sies' datatype='integer' name='[Calculation_1727923166838796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [subscribed_term_deposit] = &quot;yes&quot; THEN 1 ELSE 0 END' />
      </column>
